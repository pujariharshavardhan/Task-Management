# Leave VITE_API_URL unset in production: the app then calls /api/v1 on its own (https) origin.
# In development it defaults to http://localhost:8001/api/v1.
# VITE_API_URL=http://localhost:8001/api/v1

# Public https address — used for canonical URLs, sitemap.xml and robots.txt (also read as SITE_URL at build time).
VITE_SITE_URL=https://apms.example.com

# Shown on the Privacy Policy, Terms and footer.
VITE_ORG_NAME=Your College or Organisation
VITE_CONTACT_EMAIL=support@your-domain.com
