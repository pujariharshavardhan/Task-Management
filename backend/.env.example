# Copy to backend/.env and fill in. Never commit the real .env.
# Variable names are case-insensitive (pydantic-settings, see app/config.py).

# --- Database ---------------------------------------------------------------
# Production: Neon serverless PostgreSQL (psycopg 3 driver). Use the *pooled*
# host (the one containing "-pooler") from the Neon console "Connection string".
# postgres:// and postgresql:// URLs are also accepted; they are rewritten to
# postgresql+psycopg:// automatically by app/database.py.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Local development (default when DATABASE_URL is unset): SQLite file backend/apms.db
# DATABASE_URL=sqlite:///./apms.db
#
# After setting it:  alembic upgrade head   then   python seed.py   (run from backend/)

# --- Auth --------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS (JSON list) --------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- File storage --------------------------------------------------------------
# "local" saves under UPLOAD_DIR; "s3" uses AWS S3 or any S3-compatible store (MinIO, R2).
STORAGE_BACKEND=local
# UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# Only needed when STORAGE_BACKEND=s3
S3_BUCKET=
# Leave empty for AWS; set for MinIO, e.g. http://localhost:9000
# S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# --- Production / security ----------------------------------------------------
# ENVIRONMENT=production makes the server refuse to start with a weak JWT_SECRET or SQLite.
ENVIRONMENT=development
# Redirect every http request to https and send HSTS (turn on once a TLS certificate is in place).
FORCE_HTTPS=false
# Host names this server answers for, e.g. ["apms.example.com"] ("*" = any; development only).
ALLOWED_HOSTS=["*"]
# Sign-in / sign-up attempts per client per 15 minutes.
AUTH_RATE_LIMIT=10
